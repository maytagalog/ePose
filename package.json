{
    "name": "test",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "test": "npx playwright test",
        "test:smoke": "node scripts/runSmokeDiagnostic.mjs",
        "test:smoke:part1": "EPOSE_SMOKE_PARTS=1 node scripts/runSmokeDiagnostic.mjs",
        "test:smoke:part2": "EPOSE_SMOKE_PARTS=2 node scripts/runSmokeDiagnostic.mjs",
        "combine:smoke": "node scripts/combineSmokeResults.mjs",
        "test:smoke:legacy": "npx playwright test tests/e2e/fullE2ESmokePart1.spec.ts tests/e2e/fullE2ESmokePart2.spec.ts --workers=2",
        "pw:part1": "playwright test --config=configs/playwright/smoke/part1.config.ts",
        "pw:part2": "playwright test --config=configs/playwright/smoke/part2.config.ts",
        "pw:forgot-password": "playwright test --config=configs/playwright/login/forgotPasswordSmoke.config.ts --project=chromium",
        "test:forgot-password-fixtures": "playwright test --config=configs/playwright/login/forgotPasswordFixture.config.ts --project=chromium",
        "test:registration-resume-fixtures": "playwright test --config=configs/playwright/register/registrationResumeFixture.config.ts --project=chromium",
        "test:withdrawal-rejected-login-fixtures": "playwright test --config=configs/playwright/mypage/withdrawalRejectedLoginFixture.config.ts --project=chromium",
        "pw:ar:full": "playwright test --config=configs/playwright/analysisReport/fullSmoke.config.ts --project=chromium --workers=1",
        "pw:ar:history": "playwright test --config=configs/playwright/analysisReport/historySmoke.config.ts --project=chromium --workers=1",
        "pw:ar:comparison": "playwright test --config=configs/playwright/analysisReport/comparisonReportViewSmoke.config.ts --project=chromium --workers=1",
        "pw:ar:comparison-qr": "playwright test --config=configs/playwright/analysisReport/comparisonReportShareQrSmoke.config.ts --project=chromium --workers=1",
        "pw:ar:comparison-email": "playwright test --config=configs/playwright/analysisReport/comparisonReportShareEmailSmoke.config.ts --project=chromium --workers=1",
        "pw:ar:comparison-pdf": "playwright test --config=configs/playwright/analysisReport/comparisonReportPdfSmoke.config.ts --project=chromium --workers=1",
        "pw:ar:comparison-part2-chain": "playwright test --config=configs/playwright/analysisReport/comparisonReportPart2ChainSmoke.config.ts --project=chromium --workers=1",
        "test:part2-comparison-fixtures": "playwright test --config=configs/playwright/e2e/part2ComparisonReportingFixture.config.ts",
        "test:comparison-report-view-fixtures": "playwright test --config=configs/playwright/analysisReport/comparisonReportViewFixture.config.ts",
        "test:comparison-report-share-qr-fixtures": "playwright test --config=configs/playwright/analysisReport/comparisonReportShareQrFixture.config.ts",
        "test:comparison-report-share-email-fixtures": "playwright test --config=configs/playwright/analysisReport/comparisonReportShareEmailFixture.config.ts",
        "test:comparison-report-pdf-fixtures": "playwright test --config=configs/playwright/analysisReport/comparisonReportPdfFixture.config.ts --project=chromium",
        "pw:ar:pdf": "playwright test --config=configs/playwright/analysisReport/pdfSmoke.config.ts",
        "pw:ar:share-email": "playwright test --config=configs/playwright/analysisReport/shareEmailSmoke.config.ts --project=chromium --workers=1",
        "pw:ar:deletion-cancel": "playwright test --config=configs/playwright/analysisReport/deletionCancelSmoke.config.ts --project=chromium --workers=1",
        "pw:ar:deletion-once": "playwright test --config=configs/playwright/analysisReport/deletionDeleteOnceSmoke.config.ts --project=chromium --workers=1",
        "pw:ar:deletion-resume-once": "playwright test --config=configs/playwright/analysisReport/deletionResumeDeleteOnce.config.ts --project=chromium --workers=1",
        "pw:maint:pre-submit-recovery": "playwright test --config=configs/playwright/maintenance/preSubmitSamePlanRecovery.config.ts --project=chromium --workers=1",
        "pw:maint:reserved-recovery": "playwright test --config=configs/playwright/maintenance/reservedPlanRecovery.config.ts --project=chromium --workers=1",
        "pw:maint:legacy-finalize": "playwright test --config=configs/playwright/maintenance/legacyPlanFinalize.config.ts --project=chromium --workers=1",
        "pw:report:part2": "playwright test --config=configs/playwright/reporting/part2ReportingCheck.config.ts",
        "pw:report:share-email": "playwright test --config=configs/playwright/reporting/shareEmailReportingCheck.config.ts",
        "submit:smoke": "node scripts/submitSmokeResults.mjs",
        "test:submit-smoke-helper": "node --test scripts/submitSmokeResults.test.mjs scripts/buildTestmoSubmitJUnit.test.mjs scripts/part1TestmoReporting.test.mjs scripts/testmoSubmitFortyOneFeatures.test.mjs scripts/verifyTestmoSubmitPayload.test.mjs scripts/reconstructPart2DerivedReporting.test.mjs scripts/previewTestmoSubmitPayload.test.mjs scripts/testmoFeatureTiming.test.mjs scripts/testmoSmokeRunTiming.test.mjs scripts/testmoParallelSubmit.test.mjs scripts/testmoJUnitElapsed.test.mjs scripts/publishSmokeResults.test.mjs scripts/combineSmokeResults.test.mjs",
        "test:part2-reporting": "npx playwright test --config=configs/playwright/reporting/part2ReportingCheck.config.ts && node --test scripts/part2TestmoReporting.test.mjs scripts/buildTestmoSubmitJUnit.test.mjs",
        "test:email-state-paths": "npx playwright test tests/register/emailStateStoragePaths.spec.ts",
        "preview:testmo-submit": "node scripts/previewTestmoSubmitPayload.mjs",
        "enrich:combined-results": "node scripts/enrichCombinedResults.mjs",
        "reconstruct:part2-derived": "node scripts/reconstructPart2DerivedReporting.mjs",
        "submit-results": "npm run submit:smoke"
    },
    "keywords": [],
    "author": "",
    "type": "module",
    "license": "ISC",
    "devDependencies": {
        "@playwright/test": "^1.57.0",
        "@types/mailparser": "^3.4.6",
        "@types/node": "^25.5.0",
        "@types/pdf-parse": "^1.1.5",
        "pdf-lib": "^1.17.1",
        "pdf-parse": "^1.1.1",
        "pdfjs-dist": "^6.5.438"
    },
    "dependencies": {
        "googleapis": "^170.0.0",
        "mailparser": "^3.9.1",
        "moment": "^2.30.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    }
